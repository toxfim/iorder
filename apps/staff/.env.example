# Copy this file to .env.local in THIS app folder, then restart Vite.
# Real API mode; leave false to use the development demo adapters.
VITE_USE_REAL_API=true
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000
# Public bot username (without @); never put BOT_TOKEN in a VITE_ variable.
VITE_TELEGRAM_BOT_USERNAME=
