/// Which sign-in door a login opens. Staff logins and customer logins are separate namespaces
/// [C, 2026-10-28]: the same login may exist once per scope, and each public sign-in endpoint looks
/// only in its own scope, so a customer can never learn whether a staff login exists.
enum CredentialScope {
  STAFF
  CUSTOMER

  @@map("credential_scope")
}

/// Website sign-in data of a staff member, kept apart from `users` on purpose: a query that selects
/// a whole user row (here or in another module) can then never carry the password hash. A row
/// exists only for staff who have a password; Telegram sign-in needs none.
model StaffCredential {
  userId            String          @id @map("user_id") @db.Uuid
  scope             CredentialScope
  /// Lowercase, unique within its scope. Not a secret.
  login             String
  /// `scrypt$v1$...` (see password-hasher.ts). Never selected into a view, never returned, never audited.
  passwordHash      String          @map("password_hash")
  passwordChangedAt DateTime        @map("password_changed_at") @db.Timestamptz(3)
  /// Consecutive wrong passwords; reset by a correct one. Drives the per-login lockout.
  failedAttempts    Int             @default(0) @map("failed_attempts")
  lockedUntil       DateTime?       @map("locked_until") @db.Timestamptz(3)
  /// When the last wrong password was counted; the counter restarts after a quiet period.
  lastFailedAt      DateTime?       @map("last_failed_at") @db.Timestamptz(3)
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([scope, login])
  @@map("staff_credentials")
}

/// A website session. Only the SHA-256 of the opaque token is stored, so a database leak does not
/// hand out working sessions. The application may update only last_seen_at and revoked_at.
model StaffSession {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  /// Hex SHA-256 of the token.
  tokenHash          String             @unique @map("token_hash")
  /// How the person signed in: TELEGRAM_WIDGET or PASSWORD.
  method             String
  /// True for a session a STAFF member opened at the CUSTOMER door ([C] 2026-11-09): it resolves to
  /// the staff viewer and never carries staff powers. Fixed at creation (trigger).
  staffViewer        Boolean            @default(false) @map("staff_viewer")
  userAgent          String?            @map("user_agent")
  createdAt          DateTime           @map("created_at") @db.Timestamptz(3)
  lastSeenAt         DateTime           @map("last_seen_at") @db.Timestamptz(3)
  /// The absolute end of the session; the idle limit is checked against last_seen_at.
  expiresAt          DateTime           @map("expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?          @map("revoked_at") @db.Timestamptz(3)
  /// The dashboard session a handoff code turned into this viewer session (security review,
  /// 2026-11-10): the child ends with its source. NULL for a session opened at a sign-in door.
  sourceSessionId    String?            @map("source_session_id") @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceSession      StaffSession?      @relation("StaffSessionSource", fields: [sourceSessionId], references: [id], onDelete: Restrict)
  handedOverSessions StaffSession[]     @relation("StaffSessionSource")
  handoffCodes       StaffHandoffCode[]

  @@index([userId])
  @@map("staff_sessions")
}

/// One-time links that connect the bot for a staff member ([C] 2026-10-25): the staff app asks
/// for one, the person opens https://t.me/<bot>?start=staff_<token> and presses Start. Rows are
/// never deleted; a used or expired token can never be used again.
model TelegramLinkToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Hex SHA-256 of the token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("telegram_link_tokens")
}

/// One-time codes that let a staff member continue on the CUSTOMER site with their dashboard
/// sign-in ([C] 2026-11-09): the dashboard asks for one, the customer site exchanges it for a
/// viewer session. Only the SHA-256 of the code is stored; a code works once and for about a
/// minute. Rows are never deleted (trigger and grants).
model StaffHandoffCode {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  /// The staff session that asked for the code; the code dies with it.
  sessionId String       @map("session_id") @db.Uuid
  /// Hex SHA-256 of the code; the code itself is never stored.
  codeHash  String       @unique @map("code_hash")
  createdAt DateTime     @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  session   StaffSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([sessionId])
  @@map("staff_handoff_codes")
}
