# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Runtime environment of the api, worker and CLI commands: development | test | production.
# production turns off the development-only shortcuts (for example the seed safeguards of the
# admin bootstrap commands). The web apps do not read it: `vite` (dev server) is
# development and `vite build` is production.
NODE_ENV=development

POSTGRES_PASSWORD=change-me

# Used by apps/api (Prisma). Host port 5433 is mapped by docker-compose.yml.
DATABASE_URL=postgresql://iorder:change-me@127.0.0.1:5433/iorder_dev
TEST_DATABASE_URL=postgresql://iorder:change-me@127.0.0.1:5433/iorder_test

# Google Sheets (read-only scope). The real source is used ONLY when all three values below are set;
# otherwise the sync fails loudly as "not configured". The first real sync is run by hand:
#   pnpm --filter @iorder/api sheets:sync-once -- --confirm-real-sheet
# Path to the service account JSON key. Keep the file OUTSIDE the repository.
GOOGLE_SERVICE_ACCOUNT_FILE=
# The spreadsheet id (the long part of its URL between /d/ and /edit).
GOOGLE_SHEET_ID=
# The supplies tab. Cost, deliveries and stock are all built from it (no separate stock tab).
# The app reads only allow-listed columns, found by their header names.
GOOGLE_SHEET_SUPPLIES_TAB=Поставка

BOT_TOKEN=Telegram bot token
# Optional second bot that ONLY signs staff in on the staff website (Telegram allows one Login
# Widget domain per bot: the customer site keeps BOT_TOKEN's bot). Notifications, groups and the
# Mini App stay on BOT_TOKEN's bot. Empty: the staff widget uses BOT_TOKEN. Its username goes to the
# staff build as VITE_STAFF_TELEGRAM_BOT_USERNAME (deploy.env).
STAFF_LOGIN_BOT_TOKEN=
# Optional bot that hosts the STAFF Mini App, when it is not BOT_TOKEN's bot. OFF (empty) by default: BOT_TOKEN's bot
# then signs both Mini Apps, as before. When set, ONLY init data signed by this bot makes a staff actor; init data
# signed by BOT_TOKEN's bot makes a customer member or a staff viewer, never a staff actor (closes the "customer app
# init data opens /staff routes" limit, docs/architecture/customer-website-auth.md). It may be the same token as
# STAFF_LOGIN_BOT_TOKEN (one staff bot for the Login Widget and the Mini App); it must differ from BOT_TOKEN.
# Set TELEGRAM_STAFF_MINI_APP_URL (below) to a Mini App of THIS bot together with it.
STAFF_MINI_APP_BOT_TOKEN=
# Webhook secret of that staff bot (16-256 of A-Z a-z 0-9 _ -, different from TELEGRAM_WEBHOOK_SECRET). With it the
# staff bot answers /start in its private chat: "Xayrli tong, <name>!" and two buttons, "Brauzerda ochish" and a blue
# "Ilovada ochish". Register it once: setWebhook of the staff bot, url <api>/telegram/webhook-staff/<secret>,
# secret_token=<secret>, allowed_updates=["message"]. Empty: the route is 404 and the staff bot stays silent.
STAFF_BOT_WEBHOOK_SECRET=
DEVELOPER_TELEGRAM_ID=Telegram user id of the developer (for debugging and admin commands)
# Telegram Mini App identity (BOT_TOKEN is secret: set it only in your private .env).
# Maximum age of signed init data, in seconds (default 86400 = 24 hours, at most 604800).
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=

# How long after submitting a customer may still change the payment plan, in seconds
# (1 to 86400; empty = 180, the owner's 3 minutes).
PAYMENT_PLAN_CHANGE_WINDOW_SECONDS=
# Staff members may open the CUSTOMER app as viewers (prices and a cart, no organization)
# [C, 2026-11-09]. They can place an order ONLY where this names an organization: the order is
# then written to that ONE test organization. STAGING ONLY: the id (uuid) of the test organization.
# PRODUCTION LEAVES IT EMPTY, and the api then refuses every staff order. An id that names no
# ACTIVE organization also refuses; the api never falls back to another organization.
STAFF_ORDERING_ORGANIZATION_ID=

# Which deployed installation this is: `staging` or `production`. Empty means production. A
# deployed api (NODE_ENV=production) refuses to start when STAFF_ORDERING_ORGANIZATION_ID is set
# and this is not `staging`. Local development and tests need neither line.
APP_ENVIRONMENT=

# How long a website session lasts, in seconds (staff site and customer site share the limits).
# Empty = the defaults: 14 days without use [C, 2026-11-09] and 90 days in all [P]
# (apps/api/src/modules/identity/staff-auth.settings.ts). A value here REPLACES the default: leave
# both empty unless a shorter or longer life is wanted on purpose (at most 180 days).
STAFF_SESSION_IDLE_SECONDS=
STAFF_SESSION_ABSOLUTE_SECONDS=

# Number of reverse proxies in front of the api (0 = none). Required before going live behind a
# proxy; see docs/private/architecture/production-db-roles.md (go-live gates).
TRUST_PROXY=0
# In production the api refuses to boot with 0: every deployment sits behind Apache (one hop).

# Absolute folder for uploaded product photos. Empty = <repo>/.media (git-ignored) in development;
# required in production (deploy/compose.app.yml sets it to the mounted volume).
MEDIA_DIR=

# Telegram bot runtime. OFF unless TELEGRAM_MODE is `polling` (owner starts it by hand, dev only)
# or `webhook` (production). Both need BOT_TOKEN; webhook also needs TELEGRAM_WEBHOOK_SECRET
# (16-256 characters of A-Z a-z 0-9 _ -, used in the URL and as Telegram's secret_token).
TELEGRAM_MODE=off
# Proposed anti-spam budgets for notices about newly added Telegram groups (per process).
TELEGRAM_PENDING_NOTICES_PER_ADDER_PER_HOUR=5
TELEGRAM_PENDING_NOTICES_PER_HOUR=20
# How long a staff-created organization's one-time bot invite link works, in seconds [P].
# Empty: 7 days (604800). Allowed: 600 to 7776000.
ORGANIZATION_INVITE_TTL_SECONDS=
TELEGRAM_WEBHOOK_SECRET=
# Public base URL of the customer web app (links inside bot messages and the "Buyurtma berish"
# fallback button under the price list file posted to the groups: <WEB_APP_URL>/prices), for example https://app.example.uz
WEB_APP_URL=
# Public base URL of the staff web app (staff links inside bot messages). Empty: WEB_APP_URL is used.
# The two addresses above also connect the two sites [C, 2026-11-09]: staff continue on the
# customer site with their dashboard sign-in (a one-time code, docs/architecture/customer-website-auth.md).
# Without WEB_APP_URL the "Customer site" entry of the dashboard is hidden; without STAFF_WEB_APP_URL
# the customer site never sends a visitor to the dashboard. Both sites must share a parent domain
# (dashboard.example.uz and order.example.uz). No other setting is needed, in the api or the web apps.
STAFF_WEB_APP_URL=
# Direct link of the Telegram Mini App, must start with https://t.me/ (https://t.me/<bot>/<app> from BotFather /newapp,
# or https://t.me/<bot> for the bot's main Mini App): the button under the /price file and under the file posted to the
# groups (opened with ?startapp=prices, the catalog), and the "open in the app" button under the order messages sent to
# a customer group (opened with ?startapp=order_<order id>). Optional: without it the price button opens
# <WEB_APP_URL>/prices and a group's order message has only the "open in the browser" button.
TELEGRAM_MINI_APP_URL=
# Direct link of the STAFF Mini App (https://t.me/<bot>/<app>, BotFather /newapp with the staff app's address as the
# Web App URL). The "Open in the Mini App" button under a staff notification opens it with ?startapp=order_<order id>.
# The link must belong to the bot that signs staff in: STAFF_MINI_APP_BOT_TOKEN's bot when that is set, otherwise
# BOT_TOKEN's bot. Empty: the button is a web_app button of BOT_TOKEN's bot (as before), or absent when
# STAFF_MINI_APP_BOT_TOKEN is set. Read by the api AND the worker (the worker sends the notifications).
TELEGRAM_STAFF_MINI_APP_URL=

# Background jobs (pg-boss), run ONLY by the separate worker process: pnpm --filter @iorder/api worker
# All OFF by default. A job is scheduled only when JOBS_ENABLED=true AND its own switch is true.
# Before the first start create the pg-boss schema once: pnpm --filter @iorder/api jobs:migrate
# (optional MIGRATOR_DATABASE_URL: the owner connection used only by that command).
JOBS_ENABLED=false
# USD rate inputs, every 15 minutes 09:05-20:50 Tashkent: the Central Bank once a day (a failed fetch is retried after 30 minutes) and the public Telegram channel's daily post. Without this switch the rate has no channel value and no fresh bank value.
JOBS_USD_RATE_REFRESH_ENABLED=false
# Google Sheet sync every 10 minutes, around the clock [C, 2026-10-26]. Read-only. Needs the three GOOGLE_* values above.
JOBS_SHEET_SYNC_ENABLED=false
# Telegram outbox dispatch every 30 seconds. Also needs TELEGRAM_MODE other than off and BOT_TOKEN.
JOBS_OUTBOX_DISPATCH_ENABLED=false
# Daily price list Excel post to every organization group with price posting on, 09:00 Tashkent [P].
# At most once per group per day. The file is sent by the outbox job (JOBS_OUTBOX_DISPATCH_ENABLED).
JOBS_PRICE_POST_ENABLED=false

# Web apps (apps/staff, apps/customer). These are NAMES only; put real values in each app's
# .env.local (apps/staff/.env.local, apps/customer/.env.local; git-ignored).
# Dev server default: the in-memory fake api. VITE_USE_REAL_API=true makes `vite` talk to the real
# api instead (through the /api proxy below). VITE_USE_FAKE_API=true forces fakes in any build.
VITE_USE_REAL_API=
VITE_USE_FAKE_API=
# Where the web app calls the api: /api (same origin, prefix stripped by the dev proxy and by the
# production reverse proxy), an absolute origin (then the api needs CORS) or empty.
VITE_API_BASE_URL=/api
# Dev server only: where /api is proxied to (the api default port is 3000).
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000
# Frontend VITE_ values belong in apps/customer/.env.local and apps/staff/.env.local.
# See each app's .env.example. Vite does not load this root file.
# Telegram Login Widget on both login pages: bot username without @. Empty: no widget.
# The widget script is loaded from telegram.org at runtime, on that page only.
VITE_TELEGRAM_BOT_USERNAME=
# Link shown to people who open the Mini App outside Telegram (https://t.me/... only).
VITE_TELEGRAM_BOT_URL=
